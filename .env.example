# ==============================================================================
# frAIday Environment Configuration
# ==============================================================================

# Active Default AI Provider: groq, nvidia, openai, or ollama
AI_PROVIDER=groq

# Groq LPU Keys (Supports single key or comma-separated pool for round-robin rotation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# NVIDIA NIM Provider (Backup / High Intelligence)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Vectorize Hindsight Agent Memory
# Get your free Cloud key with promo MEMHACK99 at https://ui.hindsight.vectorize.io
# Leave blank to use frAIday's 100% offline-ready embedded TEMPR engine
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=fraiday-core-memory
